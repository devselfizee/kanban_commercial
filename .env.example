# Interface du kanban commercial — variables d'environnement.
#
# ⚠ Ces variables sont figées dans le bundle au moment du build, et lisibles par
# tout visiteur. Aucun secret ne doit y figurer.
#
# En local : copier en .env.
# Sur Coolify : les déclarer en « Build Arguments », pas en variables
# d'environnement du conteneur — elles ne sont pas lues au démarrage.

# URL publique de l'API.
# Laisser vide en développement : le proxy Vite relaie /api vers le back.
# VITE_API_URL="https://kanban-api.exemple.com"

# Keycloak, mêmes valeurs que les autres applications Selfizee.
# Sans ces variables, l'interface propose un sélecteur d'utilisateur local,
# réservé au développement.
# VITE_KEYCLOAK_URL="https://plateform-auth.exemple.com"
# VITE_KEYCLOAK_REALM="konitys"
# VITE_KEYCLOAK_CLIENT_ID="kanban-commercial"
