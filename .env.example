# Variables d'environnement du kanban commercial.
#
# Le projet comporte deux applications déployées séparément :
#   back/  — l'API (Node.js + Express + Prisma)
#   front/ — l'interface (React + Vite)
#
# Chacune a ses propres variables ; ce fichier les réunit à titre de référence.
# En local, copiez la section correspondante dans back/.env et front/.env.

# ===========================================================================
# API — back/.env
# ===========================================================================

# --- Base de données (obligatoire) ---
# Sur Coolify, utiliser l'URL interne du service PostgreSQL créé à côté de
# l'application : postgres://user:motdepasse@nom-du-service:5432/base
DATABASE_URL="postgresql://UTILISATEUR:MOTDEPASSE@HOTE:5432/kanban_commercial?schema=public"

# Port d'écoute (4000 par défaut).
# PORT=4000

# Origines autorisées à appeler l'API, séparées par des virgules.
# En production, l'URL publique du front.
# CORS_ORIGINES="https://kanban.exemple.com"

# --- Authentification Keycloak ---
# Sans KEYCLOAK_ISSUER, l'API accepte un en-tête `x-utilisateur` désignant le
# compte : mode local de développement, à ne jamais exposer publiquement.
# KEYCLOAK_ISSUER="https://plateform-auth.exemple.com/realms/NOM_DU_REALM"
# KEYCLOAK_CLIENT_ID="kanban-commercial"
#
# Rôle Keycloak ouvrant l'accès à l'application (défaut : kanban-commercial).
# Le rôle métier — commercial, LLD, manager, direction — reste géré dans le
# kanban et rapproché par l'e-mail.
# KEYCLOAK_ROLE_ACCES="kanban-commercial"

# --- Synchronisation avec le CRM (facultatif) ---
# Sans ces variables, la synchronisation reste inactive et le kanban
# fonctionne de façon autonome. Voir la section « Synchronisation » du README.
#
# API HTTP de management du bus RabbitMQ (et non le port AMQP).
# RABBITMQ_MGMT_URL="https://rabbitmq.exemple.com"
# En-tête Host à forcer lorsque l'URL pointe une IP derrière un proxy.
# RABBITMQ_HOST_HEADER=""
# RABBITMQ_VHOST=""
# RABBITMQ_USER=""
# RABBITMQ_PASSWORD=""
# Queue propre au kanban, créée automatiquement au premier appel.
# RABBITMQ_QUEUE="kanban.events.in"
# Échange publié par le CRM.
# RABBITMQ_EXCHANGE=""
# RABBITMQ_BINDINGS="crm.clients.*,crm.client_contacts.*"

# Secret protégeant POST /api/synchro.
# Sans lui, la route refuse tout appel : mieux vaut une synchronisation
# inactive qu'un point d'écriture ouvert.
# SYNCHRO_SECRET=""

# ===========================================================================
# Interface — front/.env
# ===========================================================================
#
# ⚠ Ces variables sont figées dans le bundle au moment du build, et lisibles
# par tout visiteur. Aucun secret ne doit y figurer.
# Dans Coolify, elles se déclarent en « Build Arguments », pas en variables
# d'environnement du conteneur.

# URL publique de l'API. Vide en développement : le proxy Vite s'en charge.
# VITE_API_URL="https://kanban-api.exemple.com"

# Keycloak, mêmes valeurs que les autres applications Selfizee.
# Sans ces variables, l'interface propose un sélecteur d'utilisateur local.
# VITE_KEYCLOAK_URL="https://plateform-auth.exemple.com"
# VITE_KEYCLOAK_REALM="konitys"
# VITE_KEYCLOAK_CLIENT_ID="kanban-commercial"
