# Variables d'environnement du kanban commercial.
#
# En local : copier ce fichier en .env et renseigner DATABASE_URL.
# Sur Coolify : saisir ces variables dans l'onglet « Environment Variables »
# de l'application, sans créer de fichier.

# --- Base de données (obligatoire) ---
# Sur Coolify, utiliser l'URL interne du service PostgreSQL créé à côté de
# l'application, du type : postgres://user:motdepasse@nom-du-service:5432/base
DATABASE_URL="postgresql://UTILISATEUR:MOTDEPASSE@HOTE:5432/kanban_commercial?schema=public"

# --- Authentification Keycloak ---
# Sans AUTH_KEYCLOAK_ISSUER ni AUTH_KEYCLOAK_ID, l'authentification est
# désactivée et le sélecteur d'utilisateur reprend la main. Ce mode convient au
# développement local ; il ne doit jamais être exposé publiquement.
# AUTH_KEYCLOAK_ISSUER="https://keycloak.exemple.com/realms/NOM_DU_REALM"
# AUTH_KEYCLOAK_ID="kanban-commercial"
#
# Secret du client, UNIQUEMENT si le client Keycloak est confidentiel
# (« Client authentication » sur On). Pour un client public, laisser vide :
# l'authentification se fait alors par PKCE, sans secret partagé.
# AUTH_KEYCLOAK_SECRET=""
#
# AUTH_SECRET n'a rien à voir avec Keycloak : c'est la clé qui chiffre les
# cookies de session de cette application. Vous la générez vous-même, et elle
# est obligatoire — Auth.js refuse de démarrer sans elle.
#   openssl rand -base64 32
# AUTH_SECRET=""
#
# URL publique de l'application, nécessaire au retour de Keycloak.
# AUTH_URL="https://kanban.exemple.com"
#
# Rôle Keycloak ouvrant l'accès à l'application (défaut : kanban-commercial).
# Le rôle métier — commercial, LLD, manager, direction — reste géré dans le
# kanban et rapproché par l'e-mail.
# KEYCLOAK_ROLE_ACCES="kanban-commercial"

# --- Synchronisation avec le CRM (facultatif) ---
# Sans ces variables, la synchronisation reste inactive et le kanban
# fonctionne de façon autonome. Voir la section « Synchronisation » du README.
#
# API HTTP de management du bus RabbitMQ (et non le port AMQP).
# RABBITMQ_MGMT_URL="https://rabbitmq.exemple.com"
# En-tête Host à forcer lorsque l'URL pointe une IP derrière un proxy.
# RABBITMQ_HOST_HEADER=""
# RABBITMQ_VHOST=""
# RABBITMQ_USER=""
# RABBITMQ_PASSWORD=""
# Queue propre au kanban, créée automatiquement au premier appel.
# RABBITMQ_QUEUE="kanban.events.in"
# Échange publié par le CRM.
# RABBITMQ_EXCHANGE=""
# RABBITMQ_BINDINGS="crm.clients.*,crm.client_contacts.*"

# Secret protégeant POST /api/synchro-crm.
# Sans lui, la route refuse tout appel : mieux vaut une synchronisation
# inactive qu'un point d'écriture ouvert.
# SYNCHRO_SECRET=""
